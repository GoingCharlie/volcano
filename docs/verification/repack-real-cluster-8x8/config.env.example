# kubectl 必须明确指向待测试的真实集群。脚本会拒绝在其他 context 上运行。
EXPECTED_CONTEXT="replace-with-real-cluster-context"

# 必须显式填写 8 个专用、空闲、可调度的加速卡节点，使用空格分隔。
TEST_NODES="node-01 node-02 node-03 node-04 node-05 node-06 node-07 node-08"

# 按当前测试环境给出的资源名配置。若真实 Node allocatable 中实际为
# huawei.com/ascend-1980，请在这里修正；脚本不会猜测或自动改名。
ACCELERATOR_RESOURCE="huawei.com/asend-1980"
CARDS_PER_NODE=8

# receiver 使用 4 卡，moving 使用 2 卡；moving 是唯一允许被 Repack 移动的 PodGroup。
RECEIVER_CARDS=4
MOVING_CARDS=2

# 每组验证使用独立命名空间和集群级 CR 标签。TEST_ID 必须是合法 label value/DNS 片段。
TEST_NAMESPACE="repack-real-test"
TEST_ID="repack-real-01"

# 使用真实环境已经能够拉取、且申请 Ascend 设备后可以正常 Running 的镜像。
# busybox 只是默认示例；离线环境或设备插件有镜像要求时必须替换。
TEST_IMAGE="busybox:1.36.1"
VOLCANO_SCHEDULER_NAME="volcano"

# 若加速卡节点有 NoSchedule taint，在此填写相应 tolerations JSON。
# 示例：[{"key":"accelerator","operator":"Equal","value":"ascend","effect":"NoSchedule"}]
TOLERATIONS_JSON='[]'

# 单次等待上限。默认 20 分钟，足以覆盖默认 10 分钟 Execute cooldown。
TIMEOUT_SECONDS=1200

# 临时填充 Pod 删除后，给 scheduler/repack informer 留出收敛时间。
CACHE_SETTLE_SECONDS=10

# 可选：填写当前提交的镜像 tag/sha。设置后，前置检查会要求 Repack Engine
# 所在命名空间内 controller/repack/scheduler/admission 相关 Deployment 均包含该 tag。
EXPECTED_IMAGE_TAG=""

# 安全开关。保持 false：只要选中的 8 个节点已有其他 Pod 请求该资源，前置检查就失败。
ALLOW_EXISTING_ACCELERATOR_PODS=false
